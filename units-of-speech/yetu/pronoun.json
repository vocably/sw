{"transcript":"jetu","exists":true,"definitions":["Milikishi wa kwanza wa wingi, ikimaanisha kitu kinachomilikiwa na sisi.","Kiambishi cha umilikishi kinachorejelea 'sisi' au 'yetu'."],"examples":["Nyumba yetu ni kubwa.","Hiki ni kitabu yetu.","Watoto wetu wamefika."],"lemma":"-etu","lemmaPos":"possessive adjective","synonyms":["wetu","yetu","kwetu","chetu"],"number":"plural","pluralForm":"yetu","source":"yetu"}